# Export these variables in your shell; the application does not auto-load .env.
# Name shown on the pages and in emails.
GROUP_NAME="Your team or family"

PUBLIC_BASE_URL=https://santa.example.com
# Optional until ready to send email; requires a verified sender in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Shared signup link token; generate with: openssl rand -hex 32
SITE_ACCESS_TOKEN=

# Separate admin link token; never share the shared signup token for admin access.
# Generate with: openssl rand -hex 32. Admin is disabled when unset.
ADMIN_ACCESS_TOKEN=
